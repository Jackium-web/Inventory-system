# Copy this file to .env and set values for your environment.
# Do not commit the resulting .env file.

# Generate a unique value for deployment. Required when DJANGO_DEBUG=False.
DJANGO_SECRET_KEY=

# Keep True only on your own machine.
DJANGO_DEBUG=True

# Comma-separated hostnames, without http:// or https://.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,https://hexahydric-prevocalic-brian.ngrok-free.dev

# Comma-separated HTTPS origins used for forms, for example:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://inventory.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://hexahydric-prevocalic-brian.ngrok-free.dev
